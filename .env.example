# lit-agent environment template
# Copy to `.env` and fill in. `.env` is git-ignored; never commit real keys.
#
# Priority: real process environment > `.env` > config/config.yaml > defaults
# Override syntax: LIT_AGENT_<SECTION>__<KEY>[__<SUBKEY>]=value
# Values are JSON-parsed when possible (true / 1 / ["a"]).

# --- LLM provider (any OpenAI-compatible endpoint) --------------------
# NAME is the LiteLLM provider prefix: deepseek / openai / openrouter ...
LIT_AGENT_PROVIDERS__CLOUD__NAME=deepseek
LIT_AGENT_PROVIDERS__CLOUD__BASE_URL=https://api.deepseek.com
LIT_AGENT_PROVIDERS__CLOUD__MODEL=deepseek-flash

# API key: choose ONE form.
# A) Direct (recommended)
LIT_AGENT_PROVIDERS__CLOUD__API_KEY=sk-REPLACE_ME
# B) Indirect: name the env var that holds the key
# LIT_AGENT_PROVIDERS__CLOUD__API_KEY_ENV=OPENAI_API_KEY
# OPENAI_API_KEY=sk-REPLACE_ME

# --- examples ---------------------------------------------------------
# OpenAI
# LIT_AGENT_PROVIDERS__CLOUD__NAME=openai
# LIT_AGENT_PROVIDERS__CLOUD__BASE_URL=https://api.openai.com/v1
# LIT_AGENT_PROVIDERS__CLOUD__MODEL=gpt-4o-mini
# LIT_AGENT_PROVIDERS__CLOUD__API_KEY=sk-...
#
# OpenRouter
# LIT_AGENT_PROVIDERS__CLOUD__NAME=openrouter
# LIT_AGENT_PROVIDERS__CLOUD__BASE_URL=https://openrouter.ai/api/v1
# LIT_AGENT_PROVIDERS__CLOUD__MODEL=openai/gpt-4o-mini
# LIT_AGENT_PROVIDERS__CLOUD__API_KEY=sk-or-...
#
# Local Ollama (OpenAI-compatible; dummy key)
# LIT_AGENT_PROVIDERS__CLOUD__NAME=openai
# LIT_AGENT_PROVIDERS__CLOUD__BASE_URL=http://localhost:11434/v1
# LIT_AGENT_PROVIDERS__CLOUD__MODEL=qwen2.5:7b
# LIT_AGENT_PROVIDERS__CLOUD__API_KEY=ollama

# --- config file location (optional) ----------------------------------
LIT_AGENT_CONFIG=

# --- storage root (ASCII absolute path; Kuzu needs it) ----------------
# LIT_AGENT_STORAGE__DATA_ROOT=D:/lit-agent-store/data

# --- caches (keep off C:) ---------------------------------------------
UV_CACHE_DIR=D:\lit-agent-store\uv-cache
HF_HOME=D:\lit-agent-store\hf
TORCH_HOME=D:\lit-agent-store\torch
PIP_CACHE_DIR=D:\lit-agent-store\pip-cache
