# 环境变量模板（复制为 .env 后填写；.env 不入库）
# 说明：
# 1. 密钥只放在环境变量里，任何 YAML/日志/事件都不写明文；
# 2. 配置覆盖约定：LIT_AGENT_<SECTION>__<KEY>[__<SUBKEY>]=value，值按 JSON 解析（如 true / 1 / ["a"]）；
# 3. 本机已把缓存/模型/临时目录/运行数据集中到 D:\lit-agent-store（见 scripts/env.ps1）。

# --- LLM（云端只用 DeepSeek） ---
DEEPSEEK_API_KEY=

# --- 配置文件位置（可选；默认依次找 config/config.yaml、config/config.example.yaml） ---
LIT_AGENT_CONFIG=

# --- 运行数据根（纯 ASCII 绝对路径；Kuzu 不能打开非 ASCII 路径） ---
# 等价于在 config.yaml 里写 storage.data_root
# LIT_AGENT_STORAGE__DATA_ROOT=D:/lit-agent-store/data

# --- 包缓存与模型（不要在 C: 上） ---
UV_CACHE_DIR=D:\lit-agent-store\uv-cache
HF_HOME=D:\lit-agent-store\hf
TORCH_HOME=D:\lit-agent-store\torch
PIP_CACHE_DIR=D:\lit-agent-store\pip-cache
